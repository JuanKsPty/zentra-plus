# ---------------------------------------------------------------------------
#  Zentra+ — unica fuente de variables de entorno.
#
#  Copia este archivo a .env y ajusta lo que necesites:
#      cp .env.example .env
#
#  El .env esta en .gitignore y no se versiona nunca.
# ---------------------------------------------------------------------------

# ---- Aplicacion -----------------------------------------------------------
APP_ENV=dev
APP_NAME=Zentra+

# Zona horaria del negocio. Manda en todo calculo por dia: un reporte "de hoy"
# se corta a medianoche AQUI, no en la del servidor.
TZ=America/Panama

# ---- Base de datos --------------------------------------------------------
#
#  En DESARROLLO: el Postgres que levanta docker compose.
#  En PRODUCCION: Supabase.
#
# Postgres local (solo desarrollo).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zentra
POSTGRES_PORT=5432

# La que usa la APLICACION. En desarrollo es la del host: la lee la siembra y
# cualquier comando que se corra desde la maquina. Dentro de docker compose la
# variable se sobreescribe con db:5432, que es como se llama la base en la red
# de contenedores.
#
# En produccion apunta al POOLER de Supabase (puerto 6543, modo transaccion),
# que es el que aguanta muchas conexiones cortas:
#   DATABASE_URL=postgresql+psycopg://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/zentra

# La que usan las MIGRACIONES. En desarrollo es la misma y se puede dejar vacia.
#
# En produccion tiene que ser la conexion DIRECTA de Supabase (puerto 5432), no
# el pooler: pgbouncer en modo transaccion no mantiene la sesion entre
# sentencias, y una migracion necesita bloqueos y sentencias preparadas que
# viven en la sesion. Con el pooler, un `alembic upgrade` falla a medias y deja
# el esquema en un estado intermedio, que es el peor de los desenlaces.
#   DIRECT_URL=postgresql+psycopg://postgres:<clave>@db.<ref>.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=

# ---- Seguridad ------------------------------------------------------------
# Genera cada uno con: openssl rand -hex 32
# Fuera de desarrollo la API se NIEGA a arrancar si siguen con este valor,
# si faltan, o si los dos son iguales (con el mismo secreto un token de acceso
# valdria como token de refresco y la rotacion dejaria de significar nada).
JWT_SECRET=cambia-esto-por-openssl-rand-hex-32
JWT_REFRESH_SECRET=cambia-esto-tambien-y-que-sea-distinto

# Sesion por correo: acceso corto, refresco largo.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Sesion por PIN: al reves. Acceso largo porque el operario no puede volver a
# autenticarse a mitad de servicio; refresco corto porque cuatro digitos son
# una credencial debil y la tableta se queda en la barra.
JWT_PIN_ACCESS_HOURS=4
JWT_PIN_REFRESH_HOURS=12

# ---- CORS -----------------------------------------------------------------
# Se lee como cadena separada por comas, no como lista: pydantic-settings
# intenta parsear las listas como JSON y "a,b" haria estallar el arranque.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Registro -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Frontend -------------------------------------------------------------
# VACIA a proposito: el navegador pide /api relativo y el rewrite de Next lo
# lleva a la API, asi que todo sale por un unico origen. Eso es lo que permite
# que la cookie de sesion sea sameSite=strict. Solo se rellena si alguna vez se
# quiere que el navegador hable con la API directamente. Se hornea al COMPILAR.
NEXT_PUBLIC_API_URL=
# La que usa el SERVIDOR de Next para hablar con la API. Dentro de compose la
# API se llama `api`; corriendo en la maquina, 127.0.0.1:8000.
API_INTERNAL_URL=http://api:8000

# ---- Siembra --------------------------------------------------------------
# Sin estas variables la siembra NO crea administrador fuera de desarrollo,
# para que no exista nunca un admin con credenciales publicadas en un repo.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
